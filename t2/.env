# --- CONFIGURAÇÕES DE CONEXÃO DO BANCO ---
MONGO_HOSTS=mongo1:27017,mongo2:27017,mongo3:27017

# --- VARIÁVEIS DE EXPERIMENTO ---

# Estratégia de Leitura
# 'primary' ou 'secondaryPreferred'
READ_PREFERENCE=secondaryPreferred

# Estratégia de Escrita
# '1' ou 'majority'
WRITE_CONCERN=1

# Chance de falha REAL de infraestrutura (0.0 a 1.0)
# 1.0 = Garante que vai cair
CHAOS_FAILURE_CHANCE=1.0

# MODO DO CHAOS MONKEY:
# true = Sempre descobre e mata o LÍDER (Máximo Dano)
# false = Mata um nó aleatório (Dano Variável)
CHAOS_KILL_LEADER=true

# --- VARIÁVEIS DE DADOS E CARGA ---
DATASET_SIZE=10000
COMPLEX_DOC_RATIO=0.6
USER_COUNT=5000

# --- RECURSOS ---
APP_CPUS=1
APP_MEM=512M
